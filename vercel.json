
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "output": false
    }
  },
  "crons": [
    {
      "path": "/api/sync/github",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/sync/youtube",
      "schedule": "0 8 * * *"
    }
  ]
}
